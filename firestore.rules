rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /inquiries/{id} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'name','email','company','budget','service','message','consent','status','source','createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.company is string
        && request.resource.data.company.size() <= 160
        && request.resource.data.budget is string
        && request.resource.data.service is string
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 5000
        && request.resource.data.consent == true
        && request.resource.data.status == 'new'
        && request.resource.data.source == 'website';
      allow read, update, delete: if false;
    }
  }
}
